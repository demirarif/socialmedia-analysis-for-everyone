# Optional: basic Instagram/TikTok/YouTube metrics and JSON/CSV/XLSX need no API key.
# Enable Gemini interpretation only if you want to send analysis data to Google.
# Your own API usage/quota applies. Never commit your real .env file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: enrich YouTube video statistics using the official YouTube Data API.
# Public channel/video collection also works without it. Your Google quota applies.
YOUTUBE_API_KEY=

# Local runtime storage: saved session cookie and SQLite analysis history.
# Leave unset to use this repository's .runtime directory.
# IG_ANALYSIS_DATA_DIR=

# Optional local port; the app always binds to 127.0.0.1.
# PORT=3060

# Only change these when your browser/session requires it.
# INSTAGRAM_BROWSER_MAJOR=150
# INSTAGRAM_USER_AGENT=
# INSTAGRAM_TRUST_ENV_PROXY=0
